<view class="bar-wrap">
  <view class="bar">
    <view
      class="item {{selected === index ? 'on' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-index="{{index}}"
      bindtap="onTap"
      hover-class="none"
    >
      <image class="item-icon" src="{{selected === index ? item.iconOn : item.icon}}" />
      <text class="item-text">{{item.text}}</text>
    </view>
  </view>
</view>
