/**
 * 全局样式 = 设计令牌 + 复用组件类
 * 尺寸按 750rpx 设计宽，1px(原型) ≈ 2rpx
 */

page {
  --brand: #ff6b4a;
  --brand-ink: #d64c28;
  --brand-soft: #ffede7;
  --mint: #17a67c;
  --mint-soft: #e4f6ef;
  --amber: #e08a00;
  --amber-soft: #fdf3e2;
  --violet: #6b5bd2;
  --violet-soft: #efecfc;
  --danger: #d64545;
  --danger-soft: #fcebeb;
  --ink1: #1e1b18;
  --ink2: #6b625b;
  --ink3: #a69c93;
  --line: #efe9e3;
  --line2: #e6dfd8;
  --bg: #f7f4f1;
  --card: #ffffff;

  background: var(--bg);
  color: var(--ink1);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
image {
  box-sizing: border-box;
}

/* ---------------- 通用 ---------------- */

.page {
  min-height: 100vh;
  background: var(--bg);
}

.page-body {
  padding: 0 32rpx;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.muted {
  color: var(--ink3);
}

.hairline {
  height: 1rpx;
  background: var(--line);
}

.ic {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
}

.ic-sm {
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 auto;
}

.ic-md {
  width: 40rpx;
  height: 40rpx;
}

/* ---------------- 自定义导航 ---------------- */

.navbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(247, 244, 241, 0.94);
}

.nav-inner {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 16rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

/* 导航栏 logo：与启动页 brand-mark 同一张图，圆角按比例收小 */
.brand-logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  flex: 0 0 auto;
  box-shadow: 0 4rpx 14rpx rgba(238, 78, 40, 0.22);
}

.wordmark {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
  display: flex;
  align-items: flex-end;
}

.wordmark .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-left: 6rpx;
  margin-bottom: 6rpx;
}

.nav-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.bell-wrap {
  position: relative;
  padding: 8rpx;
}

.bell-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  border: 3rpx solid var(--bg);
}

/* ---------------- 毛玻璃 banner ---------------- */

.glass-banner {
  position: relative;
  height: 236rpx;
  border-radius: 44rpx;
  overflow: hidden;
  margin: 8rpx 0 24rpx;
  /* 主题色渐变打底，右上角一点青绿、左下角一点蓝紫，其余保持主题橙 */
  background: radial-gradient(340rpx 260rpx at 88% 6%, rgba(38, 200, 158, 0.55), rgba(38, 200, 158, 0) 64%),
    radial-gradient(300rpx 240rpx at 8% 98%, rgba(126, 140, 255, 0.42), rgba(126, 140, 255, 0) 68%),
    linear-gradient(135deg, #ff6435 0%, #ff8f57 52%, #ffb887 100%);
}

/* 白磨砂层：支持 backdrop-filter 的机型是真毛玻璃，不支持的退化为浅色半透明白，文字仍是深色 */
.glass {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 44rpx;
  padding: 26rpx 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.32);
  -webkit-backdrop-filter: blur(28rpx) saturate(140%);
  backdrop-filter: blur(28rpx) saturate(140%);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.g-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.g-top {
  display: flex;
  align-items: center;
}

.g-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #7d3a22;
  letter-spacing: 2rpx;
}

.g-pill {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
  font-weight: 600;
  color: #b4432a;
}

.g-num {
  margin-top: 6rpx;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -2rpx;
  color: #2a1a12;
}

.g-num .g-unit {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0;
  margin-left: 10rpx;
  color: #5a3a2c;
}

.g-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.g-sub {
  font-size: 22rpx;
  color: #6b4535;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------- 头部分段 ---------------- */

.seg {
  display: flex;
  padding: 6rpx;
  background: #ede7e0;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  flex: 1;
  height: 66rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink2);
}

.seg-item.on {
  background: #fff;
  color: var(--ink1);
  box-shadow: 0 2rpx 8rpx rgba(60, 40, 20, 0.1);
}

.seg-badge {
  font-size: 22rpx;
  line-height: 1;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink2);
}

.seg-item.on .seg-badge {
  background: var(--brand-soft);
  color: var(--brand-ink);
}

/* ---------------- 筛选 ---------------- */

.chips {
  display: flex;
  gap: 14rpx;
  padding-bottom: 20rpx;
  white-space: nowrap;
}

.chips-wrap {
  flex-wrap: wrap;
  white-space: normal;
}

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink2);
}

.chip.on {
  background: var(--brand-soft);
  border-color: #ffd3c6;
  color: var(--brand-ink);
  font-weight: 600;
}

/* ---------------- 卡片 ---------------- */

.card {
  background: var(--card);
  border-radius: 32rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(60, 40, 20, 0.055);
}

.task {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.task-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.who {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.who-name {
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.who-sub {
  font-size: 22rpx;
  color: var(--ink3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.2rpx;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  color: var(--ink3);
  flex-wrap: wrap;
}

.task-meta .late {
  color: var(--danger);
  font-weight: 600;
}

.task-meta .mode {
  color: var(--brand-ink);
  font-weight: 600;
}

.dot-sep {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--line2);
}

.task-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

/* ---------------- 状态标签 ---------------- */

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
  flex: 0 0 auto;
}

.t-scheduled {
  background: var(--violet-soft);
  color: var(--violet);
}

.t-pending {
  background: var(--amber-soft);
  color: var(--amber);
}

.t-in_progress {
  background: var(--brand-soft);
  color: var(--brand-ink);
}

.t-overdue {
  background: var(--danger-soft);
  color: var(--danger);
}

.t-completed {
  background: var(--mint-soft);
  color: var(--mint);
}

.t-rejected,
.t-cancelled {
  background: #f1ede9;
  color: #8c8279;
}

.t-accepted {
  background: #fff3e2;
  color: #b4700a;
}

.t-done {
  background: var(--mint-soft);
  color: var(--mint);
}

.t-skipped {
  background: #f1ede9;
  color: #8c8279;
}

/* ---------------- 头像 ---------------- */

.av {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-weight: 600;
  flex: 0 0 auto;
}

.av-img {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.av-28 {
  width: 56rpx;
  height: 56rpx;
  font-size: 24rpx;
}

.av-24 {
  width: 48rpx;
  height: 48rpx;
  font-size: 21rpx;
}

.av-32 {
  width: 64rpx;
  height: 64rpx;
  font-size: 25rpx;
}

.av-56 {
  width: 112rpx;
  height: 112rpx;
  font-size: 38rpx;
  border-radius: 40rpx;
}

.av-img {
  width: 100%;
  height: 100%;
}

.stack {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.stack .av {
  border: 4rpx solid #fff;
  margin-left: -16rpx;
}

.stack .av:first-child {
  margin-left: 0;
}

.stack-dark .av {
  border-color: transparent;
}

.av-flag {
  position: relative;
}

.av-flag::after {
  content: '';
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: #d8cfc6;
}

.av-flag.done::after {
  background: var(--mint);
}

.av-flag.rejected::after {
  background: #b9aea4;
}

/* ---------------- 按钮 ---------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-primary.disabled {
  opacity: 0.45;
}

.btn-ghost {
  background: #fff;
  color: var(--ink2);
  border-color: var(--line2);
}

.btn-soft {
  background: var(--brand-soft);
  color: var(--brand-ink);
}

.btn-quiet {
  background: transparent;
  color: var(--ink3);
  font-weight: 500;
  padding: 0 8rpx;
}

.btn-sm {
  height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
}

.btn-block {
  width: 100%;
}

.btn-lg {
  height: 92rpx;
  border-radius: 26rpx;
  font-size: 30rpx;
  width: 100%;
}

/* ---------------- 悬浮按钮 ---------------- */

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(172rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 74, 0.42);
  z-index: 10;
}

/* 悬浮 tabBar 占位：tab 页内容末尾留出的空间 */
.tab-space {
  height: calc(200rpx + env(safe-area-inset-bottom));
}

/* ---------------- 表单 ---------------- */

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.flabel {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink2);
  padding-left: 4rpx;
}

.flabel .req {
  color: var(--brand);
}

.input {
  height: 88rpx;
  padding: 0 26rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  font-size: 29rpx;
  display: flex;
  align-items: center;
}

.textarea {
  min-height: 132rpx;
  padding: 18rpx 26rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  font-size: 27rpx;
  line-height: 1.6;
  width: 100%;
}

.counter {
  align-self: flex-end;
  font-size: 21rpx;
  color: var(--ink3);
  margin-top: -8rpx;
}

.row-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 96rpx;
  padding: 0 26rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  font-size: 27rpx;
  margin-bottom: 26rpx;
}

.row-line .row-label {
  font-weight: 500;
}

.row-line .row-sub {
  display: block;
  font-size: 21rpx;
  color: var(--ink3);
  font-weight: 400;
  margin-top: 2rpx;
}

.row-line .row-val {
  margin-left: auto;
  font-weight: 600;
  font-size: 27rpx;
}

.row-line .row-val.placeholder {
  color: var(--ink3);
  font-weight: 400;
}

/* 完成条件二选一 */

.opt-row {
  display: flex;
  gap: 16rpx;
}

.opt {
  flex: 1;
  padding: 18rpx 20rpx;
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.opt.on {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.opt-title {
  font-size: 26rpx;
  font-weight: 600;
}

.opt.on .opt-title {
  color: var(--brand-ink);
}

.opt-sub {
  font-size: 21rpx;
  color: var(--ink3);
  line-height: 1.4;
}

.opt.on .opt-sub {
  color: #b4634a;
}

/* 开关 */

.switch {
  margin-left: auto;
  width: 84rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #ded5cc;
  position: relative;
  transition: background 0.2s;
}

.switch.on {
  background: var(--brand);
}

.switch::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.2s;
}

.switch.on::after {
  transform: translateX(36rpx);
}

/* ---------------- 进度 ---------------- */

.progress-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(60, 40, 20, 0.05);
}

.pc-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: 23rpx;
  color: var(--ink3);
}

.pc-top .pc-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink1);
  letter-spacing: -1rpx;
}

.pc-mode {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--brand-ink);
  background: var(--brand-soft);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.bar {
  height: 10rpx;
  border-radius: 6rpx;
  background: #f0eae4;
  margin-top: 16rpx;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #ff8a64, #ff6b4a);
}

/* ---------------- 信息卡 / 区块 ---------------- */

.info-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 0 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(60, 40, 20, 0.05);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .k {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--ink3);
}

.info-row .v {
  font-weight: 600;
}

.block {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(60, 40, 20, 0.05);
}

.blabel {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink3);
  letter-spacing: 0.4rpx;
  margin-bottom: 14rpx;
}

.block-text {
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.65;
}

/* ---------------- 参与者 ---------------- */

.ppl {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 18rpx;
  background: #faf7f3;
  border-radius: 20rpx;
}

.ppl .ppl-txt {
  font-size: 22rpx;
  color: var(--ink2);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ppl .ppl-count {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink2);
}

.ppl .ppl-count .ppl-total {
  color: var(--ink3);
  font-weight: 500;
}

.p-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.p-row:last-child {
  border-bottom: none;
}

.p-row .p-sub {
  font-size: 21rpx;
  color: var(--ink3);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-row .tag {
  margin-left: auto;
}

/* ---------------- 列表行 ---------------- */

.list {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(60, 40, 20, 0.05);
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row .chev {
  margin-left: auto;
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 auto;
}

/* ---------------- 空态 ---------------- */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
}

.empty-sub {
  font-size: 23rpx;
  color: var(--ink3);
  margin-top: 10rpx;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 28rpx;
}

/* ---------------- 底部操作条 ---------------- */

.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f7f4f1 62%, rgba(247, 244, 241, 0));
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  z-index: 15;
}

.actionbar-row {
  display: flex;
  gap: 20rpx;
}

.actionbar .hint {
  font-size: 21rpx;
  color: var(--ink3);
  text-align: center;
}

.actionbar-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

/* ---------------- 服务通知（与微信同构） ---------------- */

.wx-page {
  background: #ededed;
  min-height: 100vh;
}

.wx-list {
  padding: 12rpx 24rpx 40rpx;
}

.wx-card {
  background: #f7f7f7;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.wx-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 25rpx;
  color: #7a7a7a;
}

.wx-logo {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a64, #ff5a38);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-more {
  margin-left: auto;
  color: #b2b2b2;
  letter-spacing: 2rpx;
}

.wx-div {
  height: 1rpx;
  background: #e6e6e6;
  margin: 0 24rpx;
}

.wx-title {
  padding: 22rpx 24rpx 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #191919;
  line-height: 1.4;
}

.wx-rows {
  padding: 0 24rpx 18rpx;
}

.wx-row {
  display: flex;
  font-size: 26rpx;
  line-height: 1.6;
  color: #191919;
}

.wx-row .k {
  width: 160rpx;
  flex: 0 0 auto;
  color: #8c8c8c;
}

.wx-row .v {
  flex: 1;
  word-break: break-all;
}

.wx-foot {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #576b95;
  border-top: 1rpx solid #e6e6e6;
}

.wx-mp {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
}

.wx-mini {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 2rpx solid #576b95;
  position: relative;
}

.wx-mini::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #576b95;
  transform: translate(-50%, -50%);
}

.wx-time {
  text-align: center;
  font-size: 23rpx;
  color: #9a9a9a;
  padding: 8rpx 0 16rpx;
}

/* ---------------- 提示条 ---------------- */

.tip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: var(--brand-soft);
  color: #b4634a;
  font-size: 23rpx;
  line-height: 1.5;
}

/* ---------------- 骨架 ---------------- */

.sk {
  background: linear-gradient(90deg, #ede7e0 0%, #f6f1eb 50%, #ede7e0 100%);
  background-size: 200% 100%;
  animation: sk 1.6s infinite linear;
  border-radius: 12rpx;
}

@keyframes sk {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
