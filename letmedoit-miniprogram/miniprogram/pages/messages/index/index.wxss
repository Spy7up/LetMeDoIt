.wx-toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 36rpx 8rpx;
}

.wx-toolbar-txt {
  font-size: 24rpx;
  color: #8c8c8c;
}

.wx-toolbar-btn {
  margin-left: auto;
  font-size: 24rpx;
  color: #576b95;
}

.wx-logo-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex: 0 0 auto;
}

.wx-read {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--danger);
  margin-left: 8rpx;
}

.sk-card {
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}
