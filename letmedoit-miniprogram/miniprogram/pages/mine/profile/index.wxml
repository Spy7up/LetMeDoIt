<view class="page">
  <view class="page-body">
    <view class="guide-head" wx:if="{{guide}}">
      <text class="guide-title">先让大家认出你</text>
      <text class="guide-sub">选个头像、起个名字，好友派活时更好认。也可以先跳过。</text>
    </view>

    <view class="avatar-block">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
        <view wx:else class="av av-56" style="{{avatarStyle}}">{{initial}}</view>
        <view class="avatar-mask">换</view>
      </button>
      <text class="avatar-tip">点头像，从微信头像里选</text>
    </view>

    <view class="field">
      <view class="flabel">怎么称呼你</view>
      <input
        class="input"
        type="nickname"
        placeholder="点这里，键盘上方可用微信昵称"
        placeholder-class="ph"
        maxlength="20"
        value="{{nickname}}"
        bindinput="onNickname"
        bindblur="onNickname"
      />
      <text class="counter">{{nickname.length}}/20</text>
    </view>

    <view class="tip">
      <image class="ic-sm" src="/images/icons/bell-brand.png" />
      <text>头像只在你手机上显示，好友看到的是你名字的最后一个字</text>
    </view>

    <view class="actionbar-space"></view>
  </view>

  <view class="actionbar">
    <view class="btn btn-primary btn-lg {{saving ? 'disabled' : ''}}" bindtap="save">
      {{saving ? '保存中…' : (guide ? '就这么定' : '保存')}}
    </view>
    <view wx:if="{{guide}}" class="skip" bindtap="skip">先跳过</view>
  </view>
</view>
