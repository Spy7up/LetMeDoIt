<view class="page">
  <view class="page-body">
    <view class="code-card">
      <text class="code-label">我的邀请码</text>
      <text class="code-val">{{inviteCode || '——'}}</text>
      <text class="code-tip">对方在「好友 → 添加」里输入就会加你</text>
      <view class="btn btn-primary btn-block" style="margin-top:32rpx" bindtap="copyCode">复制邀请码</view>
      <button class="btn btn-ghost btn-block share-btn" open-type="share">发给微信好友</button>
    </view>

    <view class="divider-txt">或者，输入对方的邀请码</view>

    <view class="apply-row">
      <input
        class="input apply-input"
        placeholder="6 位邀请码"
        placeholder-class="ph"
        maxlength="6"
        value="{{inputCode}}"
        bindinput="onInputCode"
      />
      <view class="btn btn-soft {{submitting ? 'disabled' : ''}}" bindtap="applyCode">添加</view>
    </view>

    <view class="tip" style="margin-top:36rpx">
      <image class="ic-sm" src="/images/icons/bell-brand.png" />
      <text>只有互相加了好友，才能给对方派活</text>
    </view>
  </view>
</view>
