/* 加好友页：比好友列表轻得多，一眼看完就点 */

.inv {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 40rpx;
}

.inv-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  min-height: 62vh;
}

.inv-muted {
  font-size: 26rpx;
  color: var(--ink3);
}

.inv-err {
  font-size: 26rpx;
  color: var(--ink2);
  text-align: center;
  line-height: 1.6;
}

.inv-retry {
  flex: 0 0 auto;
  height: 76rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
}

/* ---------------- 头部 ---------------- */

.inv-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 88rpx 0 48rpx;
}

.inv-from {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.4;
}

.inv-hint {
  font-size: 24rpx;
  color: var(--ink3);
  text-align: center;
  line-height: 1.55;
  padding: 0 24rpx;
}

/* ---------------- 邀请码 ---------------- */

.inv-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
}

.inv-card-k {
  font-size: 23rpx;
  color: var(--ink3);
  flex: 0 0 auto;
}

.inv-card-v {
  margin-left: auto;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--brand-ink);
}

/* ---------------- 说明 ---------------- */

.inv-about {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.inv-about-t {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink2);
  text-align: center;
}

.inv-about-s {
  font-size: 22rpx;
  color: var(--ink3);
  text-align: center;
}
