.form-body {
  padding-top: 28rpx;
}

.ph {
  color: var(--ink3);
}

.picker-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 16rpx 26rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.add-person {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx dashed #d6ccc3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.pick-hint {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink3);
}

.pick-tip {
  font-size: 21rpx;
  color: var(--brand-ink);
  padding-left: 4rpx;
}

/* 标题行用 flex，右侧的「图片选填 · 最多 6 张」才能贴到右边 */
.field .flabel {
  display: flex;
  align-items: center;
}

.pick-inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: auto;
}

.pick-cell {
  font-size: 27rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #faf7f3;
}

.pick-human {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink3);
}

.start-row {
  margin-top: 16rpx;
  margin-bottom: 0;
}

.row-line switch {
  transform: scale(0.9);
  transform-origin: right center;
}

/* ---------------- 发布成功后的「告诉 TA」半屏 ---------------- */

.pub-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 27, 24, 0.42);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.pub-sheet {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: pub-up 0.24s ease-out;
}

@keyframes pub-up {
  from {
    transform: translateY(40rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.pub-grab {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line2);
  margin: 0 auto 28rpx;
}

.pub-title {
  display: block;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
}

.pub-sub {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--ink3);
  line-height: 1.55;
}

.pub-task {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 32rpx 0 36rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--bg);
}

.pub-task-t {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pub-task-name {
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pub-task-time {
  font-size: 22rpx;
  color: var(--ink3);
}

/* button.btn 被 app.wxss 收成 width:auto，这里要显式撑满 */
.pub-sheet button.btn {
  width: 100%;
}

.pub-skip {
  margin-top: 20rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink3);
}
