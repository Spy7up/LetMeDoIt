.form-body {
  padding-top: 28rpx;
}

.ph {
  color: var(--ink3);
}

.picker-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 16rpx 26rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.add-person {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx dashed #d6ccc3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.pick-hint {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink3);
}

.pick-tip {
  font-size: 21rpx;
  color: var(--brand-ink);
  padding-left: 4rpx;
}

/* 标题行用 flex，右侧的「图片选填 · 最多 6 张」才能贴到右边 */
.field .flabel {
  display: flex;
  align-items: center;
}

.pick-inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: auto;
}

.pick-cell {
  font-size: 27rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #faf7f3;
}

.pick-human {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink3);
}

.start-row {
  margin-top: 16rpx;
  margin-bottom: 0;
}

.row-line switch {
  transform: scale(0.9);
  transform-origin: right center;
}
