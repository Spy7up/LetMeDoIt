<view class="page">
  <view class="page-body detail-body">
    <!-- 骨架 -->
    <block wx:if="{{loading}}">
      <view class="sk" style="width:110rpx;height:36rpx;border-radius:999rpx;margin-top:16rpx"></view>
      <view class="sk" style="width:70%;height:52rpx;margin-top:24rpx"></view>
      <view class="sk" style="width:44%;height:24rpx;margin-top:16rpx"></view>
      <view class="sk" style="width:100%;height:120rpx;margin-top:32rpx;border-radius:28rpx"></view>
      <view class="sk" style="width:100%;height:180rpx;margin-top:20rpx;border-radius:28rpx"></view>
    </block>

    <!-- 错误 -->
    <view class="empty" wx:elif="{{error}}">
      <view class="empty-ring">
        <image class="ic-md" src="/images/icons/bell-muted.png" />
      </view>
      <text class="empty-title">没加载出来</text>
      <text class="empty-sub">{{error}}</text>
      <view class="btn btn-ghost empty-btn" bindtap="load">重试</view>
    </view>

    <block wx:elif="{{task}}">
      <!-- 头部 -->
      <view class="hero">
        <view class="hero-head">
          <text class="tag {{task.statusClass}}">{{task.statusLabel}}</text>
        </view>
        <text class="hero-title">{{task.title}}</text>
        <view class="byline">
          <user-avatar user="{{task.creator}}" size="24" />
          <text>{{task.bylineText}}</text>
        </view>
      </view>

      <!-- 进度 -->
      <view class="progress-card">
        <view class="pc-top">
          <text class="pc-num">{{task.doneCount}}</text>
          <text>/{{task.totalCount}} 人已完成</text>
          <text class="pc-mode">{{task.modeText}}</text>
        </view>
        <view class="bar">
          <view class="bar-in" style="{{task.barStyle}}"></view>
        </view>
      </view>

      <!-- 基本信息 -->
      <view class="info-card">
        <view class="info-row" wx:if="{{task.startText}}">
          <view class="k">
            <image class="ic-sm" src="/images/icons/clock-muted.png" />
            <text>开始</text>
          </view>
          <text class="v">{{task.startText}}{{task.startNotify ? ' · 到点通知' : ''}}</text>
        </view>
        <view class="info-row">
          <view class="k">
            <image class="ic-sm" src="/images/icons/clock-muted.png" />
            <text>截止</text>
          </view>
          <text class="v">{{task.deadlineText}}</text>
        </view>
        <view class="info-row" wx:if="{{task.remindType !== 'none'}}">
          <view class="k">
            <image class="ic-sm" src="/images/icons/bell-muted.png" />
            <text>提醒</text>
          </view>
          <text class="v">{{task.remindMinutes > 0 ? '提前 ' + task.remindMinutes + ' 分钟' : '到点提醒'}}</text>
        </view>
        <view class="info-row">
          <view class="k"><text>布置</text></view>
          <text class="v muted">{{task.createdText}}</text>
        </view>
      </view>

      <!-- 描述 + 布置时给的参考图 -->
      <view class="block" wx:if="{{task.description || task.shotCount}}">
        <view class="blabel">{{task.isCreator ? '我交代的' : 'TA 说的'}}</view>
        <text class="block-text" wx:if="{{task.description}}">{{task.description}}</text>
        <view class="d-shots" wx:if="{{task.shotCount}}">
          <view
            class="d-shot"
            wx:for="{{task.shots}}"
            wx:key="*this"
            data-index="{{index}}"
            bindtap="previewTaskImage"
          >
            <image class="d-shot-img" src="{{item}}" mode="aspectFill" />
            <view class="d-more" wx:if="{{index === 2 && task.shotMore}}">+{{task.shotMore}}</view>
          </view>
        </view>
        <text class="d-hint" wx:if="{{task.shotCount}}">{{task.shotHint}}</text>
      </view>

      <!-- 参与者 -->
      <view class="block">
        <view class="blabel">
          <text>参与的人 · {{task.totalCount}}</text>
          <view class="blabel-ops">
            <text wx:if="{{task.canRemind}}" class="bl-op" bindtap="onRemind">催一下</text>
            <text wx:if="{{task.canAddParticipant}}" class="bl-op" bindtap="goAdd">加人</text>
          </view>
        </view>
        <view
          class="p-row {{item.shotCount ? 'p-row-rich' : ''}}"
          wx:for="{{task.participants}}"
          wx:key="userId"
        >
          <user-avatar user="{{item}}" size="32" />
          <view class="who">
            <view class="p-name">
              <text>{{item.nickname}}</text>
              <text class="p-me" wx:if="{{item.userId === task.meId}}"> · 我</text>
            </view>
            <text class="p-sub">{{item.subText}}</text>

            <!-- 完成凭证：一行最多 3 张，点开看大图 -->
            <view class="p-shots" wx:if="{{item.shotCount}}">
              <view
                class="shot"
                wx:for="{{item.shotList}}"
                wx:for-item="shot"
                wx:for-index="pi"
                wx:key="*this"
                data-index="{{index}}"
                data-pi="{{pi}}"
                catchtap="previewImage"
              >
                <image class="shot-img" src="{{shot}}" mode="aspectFill" />
                <view class="shot-more" wx:if="{{item.moreCount && pi === 2}}">+{{item.moreCount}}</view>
              </view>
            </view>
            <text class="shot-hint" wx:if="{{item.shotCount}}">{{item.shotHint}}</text>
          </view>
          <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
      </view>

      <!-- 被转发到群里、点进来的路人：只读，给一条明确的解释 -->
      <view class="stranger-note" wx:if="{{!task.isCreator && !task.me}}">
        <text class="sn-title">这不是交给你的任务</text>
        <text class="sn-sub">你可以看看内容，但不能接受或拒绝</text>
      </view>

      <!-- 进展 -->
      <view class="block" wx:if="{{task.events.length}}">
        <view class="blabel">进展</view>
        <view class="tl-item" wx:for="{{task.events}}" wx:key="id">
          <view class="tl-dot"></view>
          <view class="tl-body">
            <text class="tl-text">{{item.actor ? item.actor.nickname + ' ' : ''}}{{item.text}}</text>
            <text class="tl-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>

      <view class="actionbar-float-space"></view>
    </block>
  </view>

  <!-- 底部操作：悬浮毛玻璃胶囊，不贴边、不遮挡内容。
       注意 barMode 挂在 task 上（withBar 算出来的），不是页面 data 的顶层字段。 -->
  <view class="actionbar-float" wx:if="{{task.barMode && task.barMode !== 'none'}}">
    <!-- 发起人：分享 / 编辑 / 撤回（催办与加人在参与者区块里） -->
    <block wx:if="{{task.barMode === 'creator'}}">
      <button class="fbtn fbtn-share" open-type="share">
        <image class="fbtn-icon" src="/images/icons/share-brand.png" />
        <text>分享</text>
      </button>
      <view wx:if="{{task.canEdit}}" class="fbtn fbtn-edit" bindtap="goEdit">
        <image class="fbtn-icon" src="/images/icons/edit-violet.png" />
        <text>编辑</text>
      </view>
      <view wx:if="{{task.canCancel}}" class="fbtn fbtn-danger" bindtap="confirmCancel">
        <image class="fbtn-icon" src="/images/icons/trash-danger.png" />
        <text>撤回</text>
      </view>
    </block>

    <!-- 执行者 · 待接受 -->
    <block wx:elif="{{task.barMode === 'accept'}}">
      <view class="fbtn fbtn-ghost" style="flex:0 0 40%" bindtap="onReject">
        <image class="fbtn-icon" src="/images/icons/close-ink.png" />
        <text>拒绝</text>
      </view>
      <view class="fbtn fbtn-primary" bindtap="onAccept">
        <image class="fbtn-icon" src="/images/icons/check-white.png" />
        <text>{{acting === 'accept' ? '处理中…' : '接受'}}</text>
      </view>
    </block>

    <!-- 执行者 · 进行中 -->
    <block wx:elif="{{task.barMode === 'complete'}}">
      <view class="fbtn fbtn-mint" bindtap="goComplete">
        <image class="fbtn-icon" src="/images/icons/check-white.png" />
        <text>完成我这份</text>
      </view>
      <view wx:if="{{task.canRemind}}" class="fbtn fbtn-amber" bindtap="onRemind">
        <image class="fbtn-icon" src="/images/icons/bell-white.png" />
        <text>{{acting === 'remind' ? '已提醒' : '催一下'}}</text>
      </view>
    </block>
  </view>
</view>
