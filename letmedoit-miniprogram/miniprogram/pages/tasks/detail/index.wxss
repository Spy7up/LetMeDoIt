.detail-body {
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  padding: 8rpx 4rpx 4rpx;
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.hero-ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-edit {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-ink);
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
}

/* 撤回是破坏性操作：不用主题橙，避免和「编辑」抢注意力 */
.hero-cancel {
  color: var(--danger);
  background: var(--danger-soft);
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.6rpx;
}

.byline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--ink2);
}

.blabel-hint {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--ink3);
}

.p-name {
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.p-me {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--ink3);
}

/* 时间线 */

.tl-item {
  display: flex;
  gap: 18rpx;
  padding-bottom: 20rpx;
  position: relative;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-top: 12rpx;
  flex: 0 0 auto;
  position: relative;
  z-index: 1;
}

.tl-item:not(:last-child) .tl-dot::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 20rpx;
  width: 3rpx;
  height: 44rpx;
  background: var(--line2);
}

.tl-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.tl-text {
  font-size: 25rpx;
  color: var(--ink1);
  line-height: 1.5;
}

.tl-time {
  font-size: 21rpx;
  color: var(--ink3);
}

/* ---------------- 完成凭证（参与者行内） ---------------- */

/* 有图的行改成顶部对齐，否则状态标签会跟着图片垂直居中 */
.p-row-rich {
  align-items: flex-start;
}

.p-row-rich .tag {
  margin-top: 4rpx;
}

/* 有备注/理由时允许换行，不要截断成省略号 */
.p-row-rich .p-sub {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  line-height: 1.5;
}

.p-shots {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.shot {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--line2);
  flex: 0 0 auto;
}

.shot-img {
  display: block;
  width: 100%;
  height: 100%;
}

.shot-more {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(30, 27, 24, 0.5);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.shot-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink3);
}

/* ---------------- 布置时给的参考图 ----------------
   3 张横排铺满一行：block 内宽 634rpx = 200*3 + 12*2 gap，
   第 4 张起压成「+N」遮罩，点开看全量。 */

.d-shots {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.d-shot {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--line2);
  flex: 0 0 auto;
}

.d-shot-img {
  display: block;
  width: 100%;
  height: 100%;
}

.d-more {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(30, 27, 24, 0.5);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.d-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--ink3);
}

/* ---------------- 只读态 ---------------- */

/* 被转发到群里、点进来的路人：只读，给一条明确解释 */
.stranger-note {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 26rpx;
}

.sn-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink2);
}

.sn-sub {
  font-size: 22rpx;
  color: var(--ink3);
  text-align: center;
}

/* 区块标题右侧的小操作（催一下 / 加人）：主操作都在底部悬浮条里 */
.blabel-ops {
  margin-left: auto;
  display: flex;
  gap: 8rpx;
}

.bl-op {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand-ink);
  padding: 4rpx 10rpx;
}
