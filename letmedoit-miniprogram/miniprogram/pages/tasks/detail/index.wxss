.detail-body {
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  padding: 8rpx 4rpx 4rpx;
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.hero-ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-edit {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-ink);
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
}

/* 撤回是破坏性操作：不用主题橙，避免和「编辑」抢注意力 */
.hero-cancel {
  color: var(--danger);
  background: var(--danger-soft);
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.6rpx;
}

.byline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--ink2);
}

.blabel-hint {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--ink3);
}

.p-name {
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.p-me {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--ink3);
}

/* 时间线 */

.tl-item {
  display: flex;
  gap: 18rpx;
  padding-bottom: 20rpx;
  position: relative;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-top: 12rpx;
  flex: 0 0 auto;
  position: relative;
  z-index: 1;
}

.tl-item:not(:last-child) .tl-dot::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 20rpx;
  width: 3rpx;
  height: 44rpx;
  background: var(--line2);
}

.tl-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.tl-text {
  font-size: 25rpx;
  color: var(--ink1);
  line-height: 1.5;
}

.tl-time {
  font-size: 21rpx;
  color: var(--ink3);
}
