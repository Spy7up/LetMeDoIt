<view class="page">
  <view class="page-body">
    <view class="search-box">
      <image class="ic-sm" src="/images/icons/search-muted.png" />
      <input
        class="search-input"
        placeholder="搜备注或昵称"
        placeholder-class="ph"
        value="{{keyword}}"
        bindinput="onKeyword"
      />
    </view>

    <view class="pick-head">
      <text>已选 {{selected.length}} / {{max}}</text>
      <text class="pick-head-hint">{{mode === 'add' ? '只能加还没开始的任务' : '可以选多个人，各自做自己那份'}}</text>
    </view>

    <view class="list" wx:if="{{friends.length}}">
      <view
        class="row"
        wx:for="{{friends}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="toggle"
      >
        <view class="av av-32" style="{{item.avatarStyle}}">{{item.initial}}</view>
        <view class="who">
          <text class="who-name">{{item.remark || item.nickname}}</text>
          <text class="who-sub">{{item.activeTaskCount}} 个任务在进行</text>
        </view>
        <view class="check {{item.checked ? 'on' : ''}}">
          <image wx:if="{{item.checked}}" class="ic-sm" src="/images/icons/check-white.png" />
        </view>
      </view>
    </view>

    <view class="empty" wx:elif="{{!loading}}">
      <view class="empty-ring">
        <image class="ic-md" src="/images/icons/tab-users.png" />
      </view>
      <text class="empty-title">还没有好友</text>
      <text class="empty-sub">先去「好友」页把邀请码发给家人</text>
    </view>

    <view class="actionbar-space"></view>
  </view>

  <view class="actionbar">
    <view
      class="btn btn-primary btn-lg {{selected.length && !submitting ? '' : 'disabled'}}"
      bindtap="confirm"
    >
      {{submitting ? '处理中…' : mode === 'add' ? '加进来' : '确定（' + selected.length + '）'}}
    </view>
  </view>
</view>
