<view class="page">
  <view class="page-body">
    <view class="done-hero">
      <view class="check-circle">
        <image class="ic-md" src="/images/icons/check-mint.png" />
      </view>
      <text class="done-title">你这部分做完了？</text>
      <text class="done-sub">{{task ? '「' + task.title + '」' : ''}}{{hint ? ' · ' + hint : ''}}</text>
    </view>

    <view class="field">
      <view class="flabel">做了点什么</view>
      <textarea
        class="textarea"
        placeholder="说一句，让 TA 放心"
        placeholder-class="ph"
        maxlength="200"
        value="{{remark}}"
        bindinput="onRemark"
      />
      <text class="counter">{{remark.length}}/200</text>
    </view>

    <view class="chips chips-wrap">
      <view class="chip" wx:for="{{quick}}" wx:key="*this" data-text="{{item}}" bindtap="useQuick">
        {{item}}
      </view>
    </view>

    <view class="field" style="margin-top:26rpx">
      <view class="flabel">加张图（选填，最多 {{maxImages}} 张）</view>
      <view class="uploader">
        <view class="thumb" wx:for="{{images}}" wx:key="*this">
          <image class="thumb-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
          <view class="thumb-del" data-index="{{index}}" catchtap="removeImage">×</view>
        </view>
        <view class="thumb add" wx:if="{{images.length < maxImages && !uploading}}" bindtap="chooseImage">
          <image class="ic-md" src="/images/icons/camera-muted.png" />
          <text class="thumb-add-txt">添加</text>
        </view>
        <view class="thumb add" wx:if="{{uploading}}">
          <text class="thumb-add-txt">上传中…</text>
        </view>
      </view>
    </view>

    <view class="tip">
      <image class="ic-sm" src="/images/icons/bell-brand.png" />
      <text>完成后会通知布置者，写的话会出现在通知里</text>
    </view>

    <view class="actionbar-space"></view>
  </view>

  <view class="actionbar">
    <view class="btn btn-primary btn-lg {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中…' : '完成我这份'}}
    </view>
  </view>
</view>
