<view class="page">
  <!-- 自定义导航 -->
  <view class="navbar" style="padding-top:{{statusBarHeight}}px">
    <!-- padding-right 让开右上角胶囊，通知图标才不会被挡住 -->
    <view class="nav-inner" style="height:{{navHeight}}px;padding-right:{{navRightPad}}">
      <view class="brand">
        <image class="brand-logo" src="/images/logo.png" mode="aspectFill" />
        <view class="wordmark">让我做<view class="dot"></view></view>
      </view>
    </view>
  </view>

  <view class="page-body">
    <!-- 毛玻璃 banner：主题色打底 + 两团彩色光斑 + 白色磨砂层 -->
    <view class="glass-banner">
      <view class="glass">
        <view class="g-inner">
          <view class="g-top">
            <text class="g-label">今天</text>
            <view class="g-pill" wx:if="{{summary.overdue > 0}}">
              <image class="ic-sm" src="/images/icons/clock-brand.png" />
              <text>{{summary.overdue}} 件已逾期</text>
            </view>
          </view>
          <view class="g-num">
            {{summary.assignee}}
            <text class="g-unit">件事等你回应</text>
          </view>
          <view class="g-bottom">
            <view class="stack" wx:if="{{bannerUsers.length}}">
              <user-avatar
                wx:for="{{bannerUsers}}"
                wx:key="id"
                user="{{item}}"
                size="24"
                ring="{{true}}"
                overlap="{{index > 0}}"
              />
            </view>
            <text class="g-sub">{{bannerSub}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 角色切换 -->
    <view class="seg">
      <view class="seg-item {{role === 'assignee' ? 'on' : ''}}" data-role="assignee" bindtap="switchRole">
        <text>我收到的</text>
        <text class="seg-badge">{{summary.assignee}}</text>
      </view>
      <view class="seg-item {{role === 'creator' ? 'on' : ''}}" data-role="creator" bindtap="switchRole">
        <text>我发出的</text>
        <text class="seg-badge">{{summary.creator}}</text>
      </view>
    </view>

    <!-- 状态筛选 + 创建时间筛选 -->
    <view class="filter-row">
      <view
        class="time-trigger {{timeRange !== 'all' ? 'on' : ''}}"
        bindtap="pickTimeRange"
      >
        <text class="time-trigger-txt">{{timeLabel}}</text>
        <image class="ic-sm time-trigger-arrow" src="/images/icons/chevron-muted.png" />
      </view>
      <scroll-view class="chips-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="chips">
          <view
            class="chip {{status === item.key ? 'on' : ''}}"
            wx:for="{{filters}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="switchStatus"
            >{{item.label}}</view
          >
        </view>
      </scroll-view>
    </view>

    <!-- 骨架 -->
    <view class="list-gap" wx:if="{{loading}}">
      <view class="card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-row">
          <view class="sk" style="width:56rpx;height:56rpx;border-radius:50%"></view>
          <view style="flex:1">
            <view class="sk" style="width:40%;height:22rpx"></view>
            <view class="sk" style="width:26%;height:18rpx;margin-top:10rpx"></view>
          </view>
        </view>
        <view class="sk" style="width:64%;height:32rpx;margin-top:20rpx"></view>
        <view class="sk" style="width:44%;height:20rpx;margin-top:14rpx"></view>
      </view>
    </view>

    <!-- 错误 -->
    <view class="empty" wx:elif="{{error}}">
      <view class="empty-ring">
        <image class="ic-md" src="/images/icons/bell-muted.png" />
      </view>
      <text class="empty-title">没加载出来</text>
      <text class="empty-sub">{{error}}</text>
      <view class="btn btn-ghost empty-btn" bindtap="onPullDownRefresh">重试</view>
    </view>

    <!-- 列表 -->
    <view class="list-gap" wx:elif="{{list.length}}">
      <view
        class="card task"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="task-top">
          <user-avatar user="{{item.headUser}}" size="28" />
          <view class="who">
            <text class="who-name">{{item.headName}}</text>
            <text class="who-sub">{{item.timeAgo}}</text>
          </view>
          <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>

        <text class="task-title">{{item.title}}</text>

        <view class="task-meta">
          <image class="ic-sm" src="/images/icons/clock-muted.png" />
          <text class="{{item.timeIsLate ? 'late' : ''}}">{{item.timeText}}</text>
          <block wx:if="{{item.isMulti}}">
            <view class="dot-sep"></view>
            <text class="mode">{{item.modeText}}</text>
          </block>
        </view>

        <view class="ppl" wx:if="{{item.isMulti}}">
          <view class="stack">
            <user-avatar
              wx:for="{{item.participants}}"
              wx:for-item="p"
              wx:key="userId"
              user="{{p}}"
              size="24"
              ring="{{true}}"
              overlap="{{index > 0}}"
              flag="{{p.status === 'done' ? 'done' : ''}}"
            />
          </view>
          <text class="ppl-txt">{{item.peopleText}}</text>
          <text class="ppl-count">{{item.doneCount}}<text class="ppl-total">/{{item.totalCount}}</text></text>
        </view>

        <view
          class="task-actions"
          wx:if="{{item.showAccept || item.showComplete || item.showRemind}}"
        >
          <block wx:if="{{item.showAccept}}">
            <view class="btn btn-ghost" data-id="{{item.id}}" catchtap="onReject">拒绝</view>
            <view class="btn btn-primary" data-id="{{item.id}}" catchtap="onAccept">
              {{acting === item.id ? '处理中…' : '接受'}}
            </view>
          </block>
          <block wx:elif="{{item.showComplete}}">
            <view class="btn btn-primary" data-id="{{item.id}}" catchtap="goComplete">完成我这份</view>
          </block>
          <view
            wx:else
            class="btn btn-ghost btn-sm actions-end"
            data-id="{{item.id}}"
            catchtap="onRemind"
            >催一下</view
          >
        </view>
      </view>

      <view class="list-foot" wx:if="{{loadingMore}}">正在加载…</view>
      <view class="list-foot" wx:elif="{{!hasMore && list.length > 4}}">没有更多了</view>
    </view>

    <!-- 空态 -->
    <view class="empty" wx:else>
      <view class="empty-ring">
        <image class="ic-md" src="/images/icons/task-ghost.png" />
      </view>
      <text class="empty-title">{{empty.title}}</text>
      <text class="empty-sub">{{empty.sub}}</text>
      <view class="btn btn-ghost empty-btn" bindtap="emptyAction">{{empty.action}}</view>
    </view>
  </view>

  <!-- 通知进消息中心：和「布置任务」同一套悬浮球，未读数挂在右上角 -->
  <view class="notice-fab" bindtap="goMessages">
    <image class="ic-md" src="/images/icons/bell-ink.png" />
    <view class="notice-badge" wx:if="{{unread > 0}}">{{unread > 99 ? '99+' : unread}}</view>
  </view>

  <view class="fab" bindtap="goCreate">
    <image class="ic-md" src="/images/icons/plus-white.png" />
  </view>
</view>
