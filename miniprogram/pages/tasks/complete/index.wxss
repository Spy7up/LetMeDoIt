.done-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 40rpx 0 36rpx;
}

.check-circle {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--mint-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-title {
  font-size: 38rpx;
  font-weight: 700;
}

.done-sub {
  font-size: 23rpx;
  color: var(--ink3);
  text-align: center;
  line-height: 1.6;
  padding: 0 20rpx;
}

.ph {
  color: var(--ink3);
}

.uploader {
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
}

.thumb {
  width: 152rpx;
  height: 152rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 28rpx;
  border-bottom-left-radius: 16rpx;
}

.thumb.add {
  border: 3rpx dashed var(--line2);
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.thumb-add-txt {
  font-size: 21rpx;
  color: var(--ink3);
}
