<view class="wx-page">
  <view class="wx-toolbar" wx:if="{{unread > 0}}">
    <text class="wx-toolbar-txt">{{unread}} 条未读</text>
    <text class="wx-toolbar-btn" bindtap="markAll">全部已读</text>
  </view>

  <view class="wx-list">
    <block wx:if="{{loading}}">
      <view class="wx-card sk-card" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="sk" style="width:40%;height:24rpx;margin:24rpx"></view>
        <view class="sk" style="width:60%;height:32rpx;margin:0 24rpx 24rpx"></view>
      </view>
    </block>

    <block wx:elif="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id">
        <view class="wx-card" data-id="{{item.id}}" data-taskid="{{item.taskId}}" bindtap="openTask">
          <view class="wx-head">
            <image class="wx-logo-img" src="/images/logo.png" mode="aspectFill" />
            <text>让我做</text>
            <text class="wx-read" wx:if="{{!item.read}}"></text>
            <text class="wx-more">···</text>
          </view>
          <view class="wx-div"></view>
          <view class="wx-title">{{item.title}}</view>
          <view class="wx-rows">
            <view class="wx-row" wx:for="{{item.fields}}" wx:for-item="f" wx:key="label">
              <text class="k">{{f.label}}</text>
              <text class="v">{{f.value}}</text>
            </view>
          </view>
          <view class="wx-foot">
            进入小程序查看
            <view class="wx-mp">
              <view class="wx-mini"></view>
              <text>小程序</text>
              <image class="ic-sm" src="/images/icons/chevron-blue.png" />
            </view>
          </view>
        </view>
        <view class="wx-time">{{item.timeText}}</view>
      </view>
    </block>

    <view class="empty" wx:else>
      <view class="empty-ring">
        <image class="ic-md" src="/images/icons/bell-ghost.png" />
      </view>
      <text class="empty-title">还没有通知</text>
      <text class="empty-sub">有人给你派活、或者任务快到期，\n都会出现在这里</text>
    </view>
  </view>
</view>
