.code-card {
  margin-top: 40rpx;
  padding: 48rpx 40rpx 40rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(60, 40, 20, 0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code-label {
  font-size: 23rpx;
  color: var(--ink3);
}

.code-val {
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: var(--brand-ink);
  font-family: ui-monospace, Menlo, monospace;
}

.code-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink3);
  text-align: center;
}

button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 26rpx;
  background: #fff;
  color: var(--ink2);
  border: 1rpx solid var(--line2);
  line-height: 1;
}

button.btn::after {
  border: none;
}

.share-btn {
  margin-top: 20rpx;
}

.divider-txt {
  margin: 48rpx 0 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink3);
}

.apply-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.apply-input {
  flex: 1;
  letter-spacing: 4rpx;
  font-weight: 600;
}

.ph {
  color: var(--ink3);
  font-weight: 400;
  letter-spacing: 0;
}

.apply-row .btn {
  flex: 0 0 auto;
  height: 88rpx;
  padding: 0 44rpx;
}
