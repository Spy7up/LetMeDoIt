<view class="page">
  <view class="page-body">
    <!-- 邀请码 -->
    <view class="invite" bindtap="goInvite">
      <view class="invite-badge">邀</view>
      <view class="invite-txt">
        <text class="invite-title">把邀请码发给家人</text>
        <text class="invite-sub">输码或转发卡片，都能加你</text>
      </view>
      <text class="invite-code">{{inviteCode || '——'}}</text>
    </view>

    <!-- 好友请求 -->
    <block wx:if="{{requests.length}}">
      <view class="sec-label"><text>新的请求</text><text class="sec-num">· {{requests.length}}</text></view>
      <view class="req-card" wx:for="{{requests}}" wx:key="requestId">
        <view class="req-top">
          <view class="av av-32" style="{{item.avatarStyle}}">{{item.initial}}</view>
          <view class="who">
            <text class="who-name">{{item.nickname}}</text>
            <text class="who-sub">{{item.message}}</text>
          </view>
        </view>
        <view class="req-actions">
          <view class="btn btn-ghost btn-sm" data-id="{{item.requestId}}" catchtap="reject">忽略</view>
          <view class="btn btn-primary btn-sm" data-id="{{item.requestId}}" catchtap="accept">同意</view>
        </view>
      </view>
    </block>

    <!-- 好友列表 -->
    <view class="sec-label"><text>我的好友</text><text class="sec-num">· {{friends.length}}</text></view>

    <view class="list" wx:if="{{friends.length}}">
      <view
        class="row"
        wx:for="{{friends}}"
        wx:key="id"
        data-uid="{{item.id}}"
        data-fid="{{item.friendId}}"
        data-name="{{item.rawName}}"
        data-count="{{item.activeTaskCount}}"
        bindtap="goDetail"
      >
        <view class="av av-32" style="{{item.avatarStyle}}">{{item.initial}}</view>
        <view class="who">
          <text class="who-name">{{item.remark || item.nickname}}</text>
          <text class="who-sub">{{item.lastText}}</text>
        </view>
        <view class="row-act" data-userid="{{item.id}}" catchtap="assign">派活</view>
        <image class="chev" src="/images/icons/chevron-ghost.png" />
      </view>
    </view>

    <view class="empty" wx:elif="{{!loading}}">
      <view class="empty-ring">
        <image class="ic-md" src="/images/icons/tab-users.png" />
      </view>
      <text class="empty-title">还没有好友</text>
      <text class="empty-sub">把邀请码发给家人，\n他们输一次就能加你。</text>
      <view class="btn btn-ghost empty-btn" bindtap="goInvite">分享邀请</view>
    </view>

    <view style="height:40rpx"></view>
  </view>
</view>
