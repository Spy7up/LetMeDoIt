<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.app.module.task.dao.TaskEventDao">

    <!-- 系统事件的 actor 为空，用 notNullColumn 保证不会 new 出一个空对象 -->
    <resultMap id="eventResultMap" type="net.lab1024.sa.app.module.task.domain.vo.TaskEventVO">
        <id column="event_id" property="eventId"/>
        <result column="event_type" property="eventType"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
        <association property="actor" javaType="net.lab1024.sa.app.module.task.domain.vo.TaskUserVO"
                     notNullColumn="actor_member_id">
            <id column="actor_member_id" property="memberId"/>
            <result column="actor_nickname" property="nickname"/>
            <result column="actor_avatar" property="avatar"/>
        </association>
    </resultMap>

    <!-- 任务时间线：左连会员取操作人 -->
    <select id="queryByTaskId" resultMap="eventResultMap">
        SELECT
            e.event_id,
            e.event_type,
            e.content,
            e.create_time,
            m.member_id AS actor_member_id,
            m.nickname  AS actor_nickname,
            m.avatar    AS actor_avatar
        FROM t_task_event e
        LEFT JOIN t_wx_member m ON m.member_id = e.actor_id
        WHERE e.task_id = #{taskId}
        ORDER BY e.create_time ASC, e.event_id ASC
    </select>

</mapper>
